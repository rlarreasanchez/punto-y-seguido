{
  "name": "punto-y-seguido",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web de «Punto y seguido», unas jornadas y concurso literario: portada, ponentes, artículo y página de participación con inscripción. PEC 2 de Herramientas HTML y CSS II.",
  "keywords": [
    "html",
    "css",
    "scss",
    "bootstrap",
    "parcel",
    "concurso-literario",
    "uoc"
  ],
  "scripts": {
    "parcel:serve": "parcel -p 8123 --target web",
    "parcel:build": "parcel build --target web --no-source-maps --no-cache",
    "clean": "rimraf dist .cache .cache-loader .parcel-cache",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "dev": "npm-run-all clean parcel:serve",
    "build": "npm-run-all clean parcel:build",
    "test": "echo 'Everything is working as expected ✅\nStart working on your project by running \\033[1mnpm run dev\\033[0m'"
  },
  "targets": {
    "web": {
      "context": "browser",
      "publicUrl": "./",
      "source": [
        "src/index.html",
        "src/ponentes.html",
        "src/articulo.html",
        "src/participa.html"
      ],
      "engines": {
        "browsers": "last 2 versions, > 0.5%, not dead"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlarreasanchez/punto-y-seguido.git"
  },
  "author": {
    "name": "Rafael Larrea Sánchez"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/rlarreasanchez/punto-y-seguido/issues"
  },
  "homepage": "https://github.com/rlarreasanchez/punto-y-seguido#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@parcel/transformer-sass": "^2.16.4",
    "autoprefixer": "^10.5.5",
    "npm-run-all": "^4.1.5",
    "parcel": "^2.16.4",
    "postcss-preset-env": "^11.5.1",
    "posthtml-include": "^2.0.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.33.5",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.10.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-selector-bem-pattern": "^4.0.1"
  },
  "dependencies": {
    "@fontsource/literata": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  }
}
